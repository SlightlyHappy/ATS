# ===================
# FRONTEND INTEGRATION
# ===================
FRONTEND_URL="https://hrtool-sable.vercel.app"
ADDITIONAL_CORS_ORIGINS="http://localhost:3000,https://dev.yourapp.com"

# ===================
# SECURITY SETTINGS
# ===================
# Rate Limiting
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_REQUESTS="100"
RATE_LIMIT_HOURLY="1000"
BLOCK_THRESHOLD="500"
BLOCK_DURATION="3600"

# File Security
MAX_FILE_SIZE="52428800"
UPLOAD_FOLDER="uploads"
PROCESSED_FOLDER="processed"

# Encryption
ENCRYPTION_KEY="your-fernet-encryption-key"

# Admin Access
ADMIN_EMAILS="admin@bearsystems.co.in"

# ===================
# TRIAL CONFIGURATION
# ===================
TRIAL_RESUME_LIMIT=100
TRIAL_LEGAL_QUERIES_LIMIT=50

# ===================
# PERFORMANCE SETTINGS
# ===================
MAX_CONCURRENT_PROCESSING="2"
MAX_MEMORY_CACHE_SIZE="50"
MEMORY_WARNING_THRESHOLD="0.8"
ENABLE_CACHING="true"

# Storage Management
CLEANUP_INTERVAL_HOURS="24"
MAX_STORAGE_SIZE="1073741824"

# ===================
# LOGGING CONFIGURATION
# ===================
LOG_LEVEL="INFO"
LOG_TO_FILE="true"
LOG_FILE_PATH="logs/app.log"

