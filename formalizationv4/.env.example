# Database Pool Configuration
DATABASE_POOL_SIZE=12
DATABASE_MIN_CONNECTIONS=3
DATABASE_MAX_CONNECTIONS=12
DATABASE_CONNECTION_TIMEOUT=45
DATABASE_POOL_RECYCLE_TIME=3600

# Ollama Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
AI_TIMEOUT=300
AI_MAX_RETRIES=5
AI_TIMEOUT_SECONDS=60
MAX_CONCURRENT_AI_REQUESTS=4

# Agent Configuration
MAX_CONCURRENT_AGENTS=4
AGENT_TIMEOUT=60
ANALYSIS_CACHE_TTL=300

# File Upload Configuration
UPLOAD_FOLDER=uploads
PROCESSED_FOLDER=processed
MAX_FILE_SIZE=52428800

# Caching Configuration
ENABLE_CACHING=true
CACHE_TTL=300

# CORS and Frontend Configuration
FRONTEND_URL=https://hrtool-sable.vercel.app
ADDITIONAL_CORS_ORIGINS=http://localhost:3000,https://dev.yourapp.com

# API Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_HOURLY=1000
API_RATE_LIMIT=100 per hour

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=10
SIMPLE_HEALTH_ONLY=true

# Queue and Credit System Configuration
DEFAULT_USER_CREDITS=10
ADMIN_UNLIMITED_CREDITS=true
CREDIT_COST_PER_ANALYSIS=1
MAX_CONCURRENT_QUEUE_JOBS=3
QUEUE_PROCESSING_INTERVAL=5
MAX_QUEUE_RETRIES=3
ESTIMATED_ANALYSIS_TIME=120

# Resume and Analysis Storage
RESUME_STORAGE_PATH=uploads/resumes
BATCH_STORAGE_PATH=uploads/batches
MAX_RESUME_TEXT_LENGTH=1000000
RESUME_FILE_RETENTION_DAYS=365
ANALYSIS_RESULT_COMPRESSION=true
MAX_ANALYSIS_RESULT_SIZE=10485760

# Service Configuration
SERVICE_TYPE=web
START_WORKER=true
DEFAULT_ADMIN_EMAIL=admin@railway.app

# Railway Deployment Configuration
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=60
SSL_CERT_DAYS=820
GUNICORN_WORKERS=4
GUNICORN_THREADS=6

# Logging Configuration
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_FILE_PATH=logs/app.log


