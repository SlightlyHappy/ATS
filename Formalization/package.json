{
  "name": "bear-systems-ats",
  "version": "1.0.0",
  "description": "Bear Systems Resume Screening Application",
  "main": "backend/app.py",
  "scripts": {
    "start": "cd backend && gunicorn --bind 0.0.0.0:8000 --workers 2 --threads 4 --timeout 300 app:app",
    "build": "cd frontend && npm run build",
    "install-deps": "cd frontend && npm install && cd ../backend && pip install -r requirements.railway.txt"
  },
  "keywords": ["resume", "screening", "ats", "flask", "react"],
  "author": "Bear Systems",
  "license": "MIT",
  "engines": {
    "node": "18.x",
    "python": "3.11.x"
  }
}
