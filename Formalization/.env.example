# Supabase Configuration (Optional - falls back to custom backend if not provided)
REACT_APP_SUPABASE_URL=your-project-url.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key

# Custom Backend Configuration (Used as fallback or for admin logins)
REACT_APP_API_URL=http://localhost:8000

# Optional: Custom configurations
REACT_APP_APP_NAME=Agentic HR System
REACT_APP_TRIAL_LIMIT=100
REACT_APP_TRIAL_DAYS=30

# Feature Flags
REACT_APP_ENABLE_SUPABASE=true
REACT_APP_ENABLE_CUSTOM_AUTH=true
